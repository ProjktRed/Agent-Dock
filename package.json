{
  "name": "agent-dock",
  "productName": "Agent Dock",
  "version": "0.23.0",
  "description": "Agent Dock: Windows command center for the Codex ↔ Cline automation loop",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:engine": "npm --prefix engine test",
    "package": "electron-vite build && electron-builder --win --dir",
    "package:linux": "electron-vite build && electron-builder --linux --dir",
    "release:local": "node scripts/release-local.mjs --launch"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.5.0",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "build": {
    "appId": "local.agent-dock",
    "productName": "Agent Dock",
    "executableName": "AgentDock",
    "afterPack": "scripts/harden-electron.cjs",
    "directories": { "buildResources": "build" },
    "files": ["out/**", "package.json", "build-info.json"],
    "extraResources": [{ "from": "engine", "to": "engine", "filter": ["src/**", "skills/**", "ui/**", "package.json"] }, { "from": "scripts", "to": "scripts", "filter": ["swap.mjs"] }],
    "win": { "target": "dir", "icon": "build/icon.png" },
    "linux": { "target": "dir", "icon": "build/icon.png", "category": "Development" }
  }
}
