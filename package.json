{
  "name": "agent-dock",
  "productName": "Agent Dock",
  "version": "0.31.2",
  "description": "Agent Dock: a Windows desktop app for running AI coding agents on your projects",
  "private": true,
  "license": "MIT",
  "author": "ProjktRed",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:engine": "npm --prefix engine test",
    "package": "electron-vite build && electron-builder --win --dir --publish never",
    "package:installer": "electron-vite build && electron-builder --win nsis --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --dir",
    "release:local": "node scripts/release-local.mjs --launch"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@types/node": "22.18.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "local.agent-dock",
    "productName": "Agent Dock",
    "executableName": "AgentDock",
    "afterPack": "scripts/harden-electron.cjs",
    "directories": { "buildResources": "build" },
    "files": ["out/**", "package.json", "build-info.json"],
    "extraResources": [{ "from": "engine", "to": "engine", "filter": ["src/**", "skills/**", "ui/**", "package.json"] }, { "from": "scripts", "to": "scripts", "filter": ["swap.mjs"] }],
    "win": { "target": "dir", "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "include": "scripts/installer.nsh", "artifactName": "AgentDock-Setup-${version}-win-x64.${ext}", "shortcutName": "Agent Dock", "uninstallDisplayName": "Agent Dock", "deleteAppDataOnUninstall": false },
    "linux": { "target": "dir", "icon": "build/icon.png", "category": "Development" }
  }
}
